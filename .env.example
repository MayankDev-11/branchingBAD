# AI provider: "gemini" (free-tier demo selector) or "bedrock" (Claude Haiku 4.5 in ap-south-1)
ROOTTRACE_AI_PROVIDER=
GEMINI_API_KEY=
BEDROCK_MODEL_ID=in.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# ElevenLabs voice narration & microphone transcription (server-side)
ELEVENLABS_API_KEY=sk_bd1772c38590843fe5c7847c581b5f0fb5d67fcedaf53c27
ELEVENLABS_VOICE_ID=WQP7cQUF5aAS6Axh5yaa
ELEVENLABS_STT_MODEL=scribe_v3
ELEVENLABS_TTS_MODEL=eleven_v4_turbo

# Deployment & CORS
ENV=development
FRONTEND_ORIGINS=

# Optional SQLite database path overrides
ROOTTRACE_DB=
ROOTTRACE_AUTH_DB_PATH=
ROOTTRACE_IMPORT_DB=
ROOTTRACE_WORKSPACE_DB=

# Fitbit / Pixel Watch through the Google Health API (Google Cloud OAuth client, type "Web application")
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on the OAuth client exactly
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:5173/api/connect/google/callback
# Optional: Fernet key for encrypting stored tokens (otherwise data/secrets/token.key is created)
ROOTTRACE_TOKEN_KEY=
ROOTTRACE_CONNECTIONS_DB=
ROOTTRACE_GOOGLE_HEALTH_DIR=
